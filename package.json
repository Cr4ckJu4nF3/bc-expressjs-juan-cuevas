{
  "name": "proyecto-week-07",
  "version": "1.0.0",
  "description": "Proyecto semana 07 — Autenticación JWT (bcrypt, access/refresh, cookies HttpOnly) sobre la base de las semanas 05-06",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "seed:mongo": "tsx src/scripts/seed-metrics.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "winston": "3.17.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.15.21",
    "prisma": "6.8.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
