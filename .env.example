DATABASE_URL="postgresql://bootcamp:bootcamp123@localhost:5432/bootcamp_dev"
MONGODB_URI="mongodb://bootcamp:bootcamp123@localhost:27017/bootcamp_dev?authSource=admin"
PORT=3000
NODE_ENV=development

# Semana 07 — JWT
# Genera valores fuertes y distintos entre sí, por ejemplo con:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=cambia-este-valor-por-uno-generado-con-openssl
JWT_REFRESH_SECRET=cambia-este-otro-valor-por-uno-distinto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Opcional: ids de Campaign (Postgres) para src/scripts/seed-metrics.ts
SEED_CAMPAIGN_VERANO=
SEED_CAMPAIGN_BLACKFRIDAY=
